---
const path = Astro.url.pathname;
const navigation = [
  { href: "/projetos/", label: "Projetos" },
  { href: "/sobre/", label: "Sobre" },
  { href: "/contato/", label: "Contato" },
];
const isActive = (href: string) => path === href || (href === "/projetos/" && path.startsWith("/projetos/"));
---
<header class="site-header">
  <div class="container header-content">
    <a class="brand" href="/" aria-label="Ailton Rodrigues — página inicial">ailton<span>.dev.br</span></a>
    <nav class="desktop-navigation" aria-label="Navegação principal">
      {navigation.map(({ href, label }) => <a href={href} aria-current={isActive(href) ? "page" : undefined}>{label}</a>)}
    </nav>
    <a class="header-status" href="/contato/"><span aria-hidden="true" class="status-dot"></span> Aberto a conexões</a>
    <details class="mobile-navigation">
      <summary aria-label="Abrir menu de navegação"><span>Menu</span><span aria-hidden="true" class="menu-icon">☰</span></summary>
      <nav aria-label="Navegação móvel">
        <a href="/">Início</a>
        {navigation.map(({ href, label }) => <a href={href} aria-current={isActive(href) ? "page" : undefined}>{label}</a>)}
      </nav>
    </details>
  </div>
</header>
