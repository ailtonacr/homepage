---
interface Props {
  variant: "pastemax" | "account" | "meushape" | "crypbot" | "tavalendo" | "delivery";
  compact?: boolean;
}
const { variant, compact = false } = Astro.props;
---
<div class:list={["project-visual", "visual-" + variant, { "visual-compact": compact }]} aria-hidden="true">
  <div class="visual-browser"><span>○ ○ ○</span><span>{variant === "account" ? "AILTON DEV ACCOUNT" : variant === "pastemax" ? "PASTEMAX" : variant.toUpperCase()}</span></div>
  <div class="visual-window">
    {variant === "pastemax" && (
      <>
        <strong>Copie aqui. Continue em qualquer lugar.</strong>
        <div class="visual-tiles"><span><small>01</small>Uma ideia para guardar</span><span><small>02</small>Trecho de código</span><span><small>03</small>Link importante</span></div>
      </>
    )}
    {variant === "account" && (
      <>
        <strong>Uma conta. Todos os produtos.</strong>
        <span class="visual-small">Bem-vindo de volta</span>
        <div class="visual-input"></div><div class="visual-input short"></div><div class="visual-submit"></div>
      </>
    )}
    {variant === "meushape" && (
      <>
        <strong>Seu progresso, no seu ritmo.</strong>
        <div class="visual-bars"><span>01</span><span>02</span><span>03</span><span>04</span></div>
      </>
    )}
    {variant === "crypbot" && (
      <>
        <strong>CRYPBOT / AUTOMATION</strong>
        <code>&gt; uptime: running<br />&gt; data: processing<br />&gt; bots: monitored<br />&gt; status: healthy</code>
      </>
    )}
    {variant === "tavalendo" && (
      <>
        <strong>Tá Valendo.</strong>
        <div class="visual-tiles"><span><small>01</small>Uma ideia</span><span><small>02</small>Uma experiência</span><span><small>03</small>Um produto</span></div>
      </>
    )}
    {variant === "delivery" && (
      <>
        <strong>Delivery Express.</strong>
        <p>Jornadas digitais para conectar serviços e pessoas.</p>
        <div class="visual-route">ORIGEM ━━━ ● ━━━ DESTINO</div>
      </>
    )}
  </div>
</div>
