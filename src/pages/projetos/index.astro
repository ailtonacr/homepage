---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const filters = [
  { value: "todos", label: "Todos" },
  { value: "produto", label: "Aplicações" },
  { value: "infraestrutura", label: "Infraestrutura" },
  { value: "automacao", label: "Automação" },
  { value: "experimento", label: "Experimentos" },
];
---
<SiteLayout title="Projetos | Ailton Rodrigues" description="Conheça os projetos, produtos digitais e estudos técnicos de Ailton Rodrigues.">
  <section class="container page-intro">
    <span class="eyebrow">Portfólio / Todos os projetos</span>
    <h1>Ideias que encontrei<br />no caminho.</h1>
    <p>Produtos, sistemas e experimentos. Cada projeto representa uma pergunta diferente que eu tentei responder com software.</p>
    <div class="project-filters" role="group" aria-label="Filtrar projetos">
      {filters.map(({ value, label }) => <button type="button" class="filter-button" aria-pressed={value === "todos" ? "true" : "false"} data-project-filter={value}>{label}{value === "todos" && <span> ({String(projects.length).padStart(2, "0")})</span>}</button>)}
    </div>
  </section>
  <section class="container catalog" aria-label="Lista de projetos">
    {projects.map((project, index) => (
      <article class="catalog-row" data-project-category={project.data.category}>
        <span class="catalog-number">{String(index + 1).padStart(2, "0")}</span>
        <div class="catalog-info">
          <h2><a href={"/projetos/" + project.id + "/"} data-track-event="select_project" data-track-project={project.id}>{project.data.title}</a></h2>
          <p class="eyebrow">{project.data.eyebrow}</p>
          <p>{project.data.summary}</p>
          <div class="catalog-tags">{project.data.tags.slice(0, 3).join(" / ")}</div>
        </div>
        <a class="catalog-poster" data-color={project.data.visual} href={"/projetos/" + project.id + "/"} data-track-event="select_project" data-track-project={project.id} aria-label={"Ler estudo de caso de " + project.data.title}>
          <span>// ailton.dev.br — {String(index + 1).padStart(2, "0")}</span>
          <strong>{project.data.title}</strong>
          <em>Ver história do projeto →</em>
        </a>
      </article>
    ))}
  </section>
  <section class="catalog-end"><div class="container"><span class="eyebrow">Não viu o que procurava?</span><h2>Ainda tem muita coisa sendo feita.</h2><a href="/contato/" class="link-arrow">Vamos conversar <span aria-hidden="true">→</span></a></div></section>
</SiteLayout>
<script>
  const filters = document.querySelectorAll<HTMLButtonElement>("[data-project-filter]");
  const rows = document.querySelectorAll<HTMLElement>("[data-project-category]");
  filters.forEach((button) => button.addEventListener("click", () => {
    const selected = button.dataset.projectFilter;
    filters.forEach((item) => item.setAttribute("aria-pressed", item === button ? "true" : "false"));
    rows.forEach((row) => { row.hidden = selected !== "todos" && row.dataset.projectCategory !== selected; });
  }));
</script>
