---
import SiteLayout from "../layouts/SiteLayout.astro";
import { t, type Locale } from "../i18n";
interface Props { lang: Locale }
const { lang } = Astro.props;
---
<SiteLayout lang={lang} title={t(lang,"navContact") + " | Ailton Rodrigues"} description={t(lang,"contactMetaDescription")}>
  <div class="container contact-layout">
    <section aria-labelledby="contact-title">
      <span class="eyebrow">{t(lang,"contactKicker")}</span>
      <h1 id="contact-title">{t(lang,"contactTitleFirst")}<br />{t(lang,"contactTitleSecond")}</h1>
      <p class="contact-intro">{t(lang,"contactDescription")}</p>
      <div class="contact-links">
        <a class="contact-link" href="https://github.com/ailtonacr" target="_blank" rel="noopener noreferrer" data-track-event="contact_click"><span class="eyebrow">GitHub</span><strong>github.com/ailtonacr →</strong></a>
        <a class="contact-link" href="https://www.linkedin.com/in/ailtonacr/" target="_blank" rel="noopener noreferrer" data-track-event="contact_click"><span class="eyebrow">LinkedIn</span><strong>linkedin.com/in/ailtonacr →</strong></a>
      </div>
    </section>
    <aside class="contact-panel">
      <span class="eyebrow">{t(lang,"startHere")}</span><h2>{t(lang,"writeMessage")}</h2>
      <p>{t(lang,"contactLinkedIn")}</p>
      <a class="button button-primary" href="https://www.linkedin.com/in/ailtonacr/" target="_blank" rel="noopener noreferrer" data-track-event="contact_click">{t(lang,"sendLinkedIn")} <span aria-hidden="true">↗</span></a>
      <p style="margin-top:18px;font-size:.86rem">{t(lang,"noFakeForm")}</p>
    </aside>
  </div>
  <section class="contact-note"><div class="container">
    <span class="eyebrow">{t(lang,"lastThing")}</span>
    <h2>{t(lang,"smallProjectsFirst")}<br />{t(lang,"smallProjectsSecond")}</h2>
  </div></section>
</SiteLayout>
